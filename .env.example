# Copy to .env before `docker compose up`.
# APP_KEY may stay empty: the web container generates one on first start and keeps
# it in the web-storage volume. Set it explicitly to reuse an existing key.

WEB_PORT=8080
API_PORT=8000

DB_DATABASE=myventory
DB_USERNAME=myventory
DB_PASSWORD=myventory
DB_PORT_FORWARD=5432

APP_KEY=
APP_URL=http://localhost:8080

# Base URL used by the mobile app (Flutter). Android emulator reaches the host
# through 10.0.2.2; a physical device needs the host LAN IP or an ngrok URL.
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8080/api/v1

# Import ML/data/Transactions.csv on first boot. Set to false for an empty database.
MYVENTORY_SEED=true
